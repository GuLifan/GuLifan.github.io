<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ profile.description }}">
    <meta name="author" content="{{ profile.name }}">
    <meta name="theme-color" content="#071116">
    <meta name="color-scheme" content="dark light">
    <link rel="canonical" href="{{ profile.siteUrl }}{{ page.url }}">
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/assets/css/styles.css">

    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ title or profile.name }}">
    <meta property="og:description" content="{{ profile.description }}">
    <meta property="og:url" content="{{ profile.siteUrl }}{{ page.url }}">
    <meta property="og:image" content="{{ profile.avatar }}">
    <meta property="og:site_name" content="{{ profile.name }}">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ title or profile.name }}">
    <meta name="twitter:description" content="{{ profile.description }}">
    <meta name="twitter:image" content="{{ profile.avatar }}">

    <title>{{ title or profile.name }}</title>

    <script>
      // 尽早应用用户上次选择的主题，避免页面加载时出现明暗闪烁。
      try {
        const savedTheme = localStorage.getItem("theme");
        if (savedTheme === "light" || savedTheme === "dark") {
          document.documentElement.dataset.theme = savedTheme;
        }
      } catch (_) {}
    </script>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "{{ profile.name }}",
        "alternateName": "{{ profile.nameZh }}",
        "url": "{{ profile.siteUrl }}",
        "image": "{{ profile.avatar }}",
        "jobTitle": "{{ profile.title }}",
        "affiliation": {
          "@type": "Organization",
          "name": "{{ profile.affiliation }}"
        },
        "email": "mailto:{{ profile.email }}",
        "sameAs": ["{{ profile.github }}", "{{ profile.orcid }}"]
      }
    </script>

    {% if profile.goatCounterCode %}
    <script
      data-goatcounter="https://{{ profile.goatCounterCode }}.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"
    ></script>
    {% endif %}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {{ content | safe }}
    <script src="/assets/js/main.js" defer></script>
  </body>
</html>
